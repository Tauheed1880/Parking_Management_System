__pycache__/
*.pyc
*.pyo
*.egg-info/

# YOLO model weights (if large >100MB, host separately)
*.pt

# PaddleOCR cache
.paddlex/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Environment variables
.env